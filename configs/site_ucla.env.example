#  / academic-medical-center site profile
# Copy to a local .env that is NOT committed. Native Python only — no Docker,
# no Singularity. Rose Gold calls the site-approved LLM; it does not install one.
#
# Recommended at : Amazon Bedrock Mantle (OpenAI-compatible Chat Completions).
# Needs a Bedrock API key + region + approved model id. No boto3, no containers.

# ---------------------------------------------------------------------------
# Option A — Bedrock Mantle (recommended)
# ---------------------------------------------------------------------------
ROSEGOLD_LLM_BACKEND=mantle
AWS_REGION=us-west-2
# Bedrock API key from the AWS console (not an OpenAI key).
# Also accepted as ROSEGOLD_OPENAI_API_KEY.
AWS_BEARER_TOKEN_BEDROCK=
# Model id  Health has already approved on Mantle, e.g. openai.gpt-oss-120b
# or an Anthropic / site-specific id. Confirm with  IT.
ROSEGOLD_OPENAI_MODEL=YOUR-APPROVED-MANTLE-MODEL
# Default URL is https://bedrock-mantle.${AWS_REGION}.api.aws/v1
# Some models need the OpenAI-prefixed path:
# ROSEGOLD_MANTLE_PATH=openai/v1

# ---------------------------------------------------------------------------
# Option B — Databricks Model Serving (if Mantle is not the approved path)
# ---------------------------------------------------------------------------
# ROSEGOLD_LLM_BACKEND=databricks
# DATABRICKS_HOST=https://YOUR-WORKSPACE.azuredatabricks.net
# DATABRICKS_TOKEN=
# ROSEGOLD_OPENAI_MODEL=YOUR-APPROVED-SERVING-ENDPOINT

# ---------------------------------------------------------------------------
# Option C — Native Bedrock Converse (IAM / boto3), only if IT requires it
# ---------------------------------------------------------------------------
# ROSEGOLD_LLM_BACKEND=bedrock
# ROSEGOLD_BEDROCK_API=converse
# ROSEGOLD_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=us-west-2
# Then: pip install -r requirements-bedrock.txt

# Shared
ROSEGOLD_OPENAI_TIMEOUT=45
ROSEGOLD_DATA_DIR=data
ROSEGOLD_OUTPUT_DIR=outputs
# ROSEGOLD_API_KEY=
